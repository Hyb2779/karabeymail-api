# Public Email API ortam değişkenleri — kopyala: cp .env.example .env

PORT=4200

# Maileroo panelinden alınan GERÇEK API key (sending key)
# Bu, bizim değil, Maileroo'nun bize verdiği kimlik bilgisi
MAILEROO_API_KEY=

# Bizim kendi ürettiğimiz, bu endpoint'e erişecek istemcilerin kullanacağı token
# Üretmek için: npm run gen-token
PUBLIC_EMAIL_API_TOKEN=
